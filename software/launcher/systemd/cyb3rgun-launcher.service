[Unit]
Description=CYB3RGUN launcher
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/halo-gauge-experiment/software/launcher
ExecStart=/usr/bin/python3 %h/halo-gauge-experiment/software/launcher/launcher.py --host 0.0.0.0
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
