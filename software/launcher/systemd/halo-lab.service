[Unit]
Description=HALO LAB measurement server
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/halo-gauge-experiment
ExecStart=/usr/bin/python3 %h/halo-gauge-experiment/software/labui/halo_lab.py --port /dev/ttyUSB0 --host 0.0.0.0
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
